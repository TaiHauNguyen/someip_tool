# Python bytecode
__pycache__/
*.py[cod]

# The licence signing key is committed deliberately - see README.md.
# Issued licences belong to one machine each, so those stay out.
license.key
*.license.key

# PyInstaller output - rebuild it with build.bat, do not ship it through git
build/
dist/
dist-license-tool/
*.spec

# editor and OS local state
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# the lock file Excel leaves behind while a workbook is open
~$*.xlsx

# what bootstrap_zafl.py writes; regenerate it rather than committing it
*.someip.json
*.generated.arxml
